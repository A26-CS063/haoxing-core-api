# Server Environment
PORT=3000
NODE_ENV=development

# Database Connection (Neon Serverless PostgreSQL)
# DATABASE_URL: Connection pooler (-pooler) for Express runtime
DATABASE_URL="postgresql://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct unpooled connection for prisma migrate
DIRECT_URL="postgresql://username:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Configuration
JWT_SECRET="rahasia bgt"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="rahasia bg"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis Cache & Rate Limiting (Upstash Cloud Redis)
REDIS_URL="rediss://default:password@sample-redis.upstash.io:6379"
